# Amp self-hosted provider token. Easiest: create the provider with
#   amp orb provider create <name>
# and Amp stores its token for this user, so leave this unset.
# Or paste the aop_live_ token from Amp Settings -> Orbs:
# AMP_ORB_PROVIDER_TOKEN=aop_live_...

# Agent37 workspace API key from the Agent37 dashboard.
AGENT37_API_KEY=REPLACE_WITH_AGENT37_API_KEY

# Agent37 workspace template that runs Amp's orb image (see README).
AGENT37_TEMPLATE=amp-orb

# Optional overrides.
# AGENT37_REGION=us
# AGENT37_TYPE=default
# AGENT37_CPU=4
# AGENT37_MEMORY=8
# AGENT37_DISK=8
# AGENT37_BOOTSTRAP_LOG=/home/user/.amp-bootstrap.log
